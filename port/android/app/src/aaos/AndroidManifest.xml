<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <application android:roundIcon="@mipmap/ic_launcher" android:resizeableActivity="true">
        <!-- Allow more scheduling headroom on automotive systems. SDL imports
             SDL_ENV metadata before opening audio; mobile keeps its default. -->
        <meta-data android:name="SDL_ENV.SDL_AUDIO_DEVICE_SAMPLE_FRAMES" android:value="2048" />
        <!-- Parked game: intentionally no distractionOptimized metadata. -->
        <activity android:name=".LauncherActivity" android:screenOrientation="unspecified"
            android:resizeableActivity="true" tools:replace="android:screenOrientation" />
        <activity android:name=".HaloActivity" android:screenOrientation="unspecified"
            android:resizeableActivity="true" android:launchMode="standard"
            tools:replace="android:screenOrientation,android:resizeableActivity,android:launchMode" />
        <provider android:name=".UpdateProvider" tools:node="remove" />
        <receiver android:name=".UpdateReceiver" tools:node="remove" />
    </application>
</manifest>
